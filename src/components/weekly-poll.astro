---
// Weekly Scouting poll for the home page. The questions live in
// src/data/weekly-poll.yaml; votes go to the small vote server on the home
// server (poll-server/), which also saves each week's tallies to the
// filestore. The current week is picked in the browser, so the poll changes
// every Monday without a site rebuild.
import polls from '~/data/weekly-poll.yaml';
import { DateTime } from 'luxon';

interface Poll {
    week: string;
    question: string;
    options: string[];
    fact?: string;
}

const list = polls as Poll[];

// Remind at build time when the question list is about to run out
const lastWeek = list.length ? list[list.length - 1].week : '';
const weeksLeft = lastWeek
    ? Math.floor(
          DateTime.fromISO(lastWeek, { zone: 'America/Chicago' })
              .diffNow('weeks')
              .weeks
      ) + 1
    : 0;
if (weeksLeft <= 4) {
    console.warn(
        `\n*** Weekly poll: only ${Math.max(weeksLeft, 0)} week(s) of questions left ` +
            `(last week starts ${lastWeek}). Add more to src/data/weekly-poll.yaml. ***\n`
    );
}
---

<section class="weekly-poll" hidden data-polls={JSON.stringify(list)}>
    <h2>Bucky's Weekly Poll</h2>
    <div class="poll-card">
        <div class="poll-question"></div>
        <div class="poll-options"></div>
        <div class="poll-results" hidden></div>
        <div class="poll-fact" hidden></div>
        <div class="poll-note"></div>
    </div>
    <div class="poll-last-week" hidden></div>
</section>

<script>
    const API =
        location.hostname === 'localhost' || location.hostname === '127.0.0.1'
            ? 'http://localhost:8787/poll'
            : 'https://filestore.scoutmasterbucky.com/poll';

    interface Poll {
        week: string;
        question: string;
        options: string[];
        fact?: string;
    }
    interface Tally {
        week: string;
        counts: number[];
        total: number;
    }

    // Today's date in Bucky Time (Central), as YYYY-MM-DD. On a local dev server,
    // ?poll-date=YYYY-MM-DD pretends it is another day, for testing.
    function todayCentral() {
        const test = new URLSearchParams(location.search).get('poll-date');
        if (test && API.startsWith('http://localhost')) return test;
        return new Intl.DateTimeFormat('en-CA', {
            timeZone: 'America/Chicago',
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
        }).format(new Date());
    }

    function storageGet(key: string) {
        try {
            return localStorage.getItem(key);
        } catch {
            return null;
        }
    }
    function storageSet(key: string, value: string) {
        try {
            localStorage.setItem(key, value);
        } catch {}
    }

    async function getTally(week: string): Promise<Tally | null> {
        try {
            const r = await fetch(`${API}/results?week=${week}`);
            return r.ok ? await r.json() : null;
        } catch {
            return null;
        }
    }

    function showResults(box: HTMLElement, poll: Poll, tally: Tally, mine: number | null) {
        // Rank the answers from most to fewest votes
        const ranked = poll.options
            .map((text, i) => ({ text, i, n: tally.counts[i] ?? 0 }))
            .sort((a, b) => b.n - a.n || a.i - b.i);
        box.replaceChildren(
            ...ranked.map((o, place) => {
                const pct = tally.total ? Math.round((o.n * 100) / tally.total) : 0;
                const row = document.createElement('div');
                row.className = 'poll-row' + (o.i === mine ? ' mine' : '');
                row.innerHTML = `
                    <div class="poll-row-label"><span class="poll-place"></span><span class="poll-text"></span><span class="poll-pct"></span></div>
                    <div class="poll-bar"><div class="poll-fill"></div></div>`;
                row.querySelector('.poll-place')!.textContent = `${place + 1}.`;
                row.querySelector('.poll-text')!.textContent = o.text + (o.i === mine ? ' (your pick)' : '');
                row.querySelector('.poll-pct')!.textContent = `${pct}%`;
                (row.querySelector('.poll-fill') as HTMLElement).style.width = `${pct}%`;
                return row;
            })
        );
        const total = document.createElement('div');
        total.className = 'poll-total';
        total.textContent = `${tally.total} ${tally.total === 1 ? 'vote' : 'votes'} so far. A new question every Monday!`;
        box.append(total);
        box.hidden = false;
    }

    async function start(section: HTMLElement) {
        const polls: Poll[] = JSON.parse(section.dataset.polls || '[]');
        const today = todayCentral();
        const started = polls.filter(p => p.week <= today);
        const poll = started[started.length - 1];
        if (!poll) return;
        // An old question is not shown once the list runs out (more than a week past its start)
        const end = polls[polls.indexOf(poll) + 1]?.week;
        const weekEnd = new Date(poll.week + 'T12:00:00');
        weekEnd.setDate(weekEnd.getDate() + 7);
        if (!end && weekEnd.toISOString().slice(0, 10) <= today) return;

        const q = section.querySelector('.poll-question') as HTMLElement;
        const opts = section.querySelector('.poll-options') as HTMLElement;
        const results = section.querySelector('.poll-results') as HTMLElement;
        const fact = section.querySelector('.poll-fact') as HTMLElement;
        const note = section.querySelector('.poll-note') as HTMLElement;
        q.textContent = poll.question;
        section.hidden = false;

        const key = `smb-poll-${poll.week}`;
        const saved = storageGet(key);
        const showFact = () => {
            if (poll.fact) {
                fact.textContent = poll.fact;
                fact.hidden = false;
            }
        };

        if (saved !== null) {
            const tally = await getTally(poll.week);
            if (tally) showResults(results, poll, tally, Number(saved));
            else note.textContent = 'Thanks for voting! Results are taking a short break; check back soon.';
            showFact();
        } else {
            opts.replaceChildren(
                ...poll.options.map((text, i) => {
                    const b = document.createElement('button');
                    b.type = 'button';
                    b.className = 'poll-option';
                    b.textContent = text;
                    b.addEventListener('click', async () => {
                        opts.querySelectorAll('button').forEach(x => ((x as HTMLButtonElement).disabled = true));
                        note.textContent = 'Counting your vote...';
                        try {
                            const r = await fetch(`${API}/vote`, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ week: poll.week, choice: i }),
                            });
                            if (!r.ok) throw new Error(String(r.status));
                            const tally: Tally = await r.json();
                            storageSet(key, String(i));
                            opts.replaceChildren();
                            note.textContent = '';
                            showResults(results, poll, tally, i);
                            showFact();
                        } catch {
                            note.textContent = 'The vote counter is taking a short break. Please try again later.';
                            opts.querySelectorAll('button').forEach(x => ((x as HTMLButtonElement).disabled = false));
                        }
                    });
                    return b;
                })
            );
        }

        // Last week's winner, when there is one
        const prev = started[started.length - 2];
        if (prev) {
            const t = await getTally(prev.week);
            if (t && t.total > 0) {
                const top = t.counts.indexOf(Math.max(...t.counts));
                const pct = Math.round((t.counts[top] * 100) / t.total);
                const last = section.querySelector('.poll-last-week') as HTMLElement;
                last.textContent = `Last week: "${prev.question}" Top answer: ${prev.options[top]} (${pct}%).`;
                last.hidden = false;
            }
        }
    }

    document.querySelectorAll<HTMLElement>('.weekly-poll').forEach(start);
</script>

<style is:global>
    /* global so the buttons and result rows the script creates are styled;
       every rule is kept inside .weekly-poll */
    .weekly-poll {
        max-width: 40em;
        margin: 1em auto 2em;
    }

    .weekly-poll h2 {
        text-align: center;
    }

    .weekly-poll .poll-card {
        padding: 1em 1.25em;
        border: 2px solid var(--palette-light);
        border-radius: 0.75em;
        background: var(--palette-very-light);
    }

    .weekly-poll .poll-question {
        font-weight: bold;
        font-size: 1.2em;
        color: var(--smb-text-color);
        text-align: center;
        margin-bottom: 0.75em;
    }

    .weekly-poll .poll-options {
        display: flex;
        flex-direction: column;
        gap: 0.5em;
    }

    .weekly-poll .poll-option {
        padding: 0.6em 1em;
        border: 2px solid var(--palette-dark);
        border-radius: 999px;
        background: var(--palette-white);
        color: var(--palette-very-dark);
        font: inherit;
        font-weight: bold;
        cursor: pointer;
    }

    .weekly-poll .poll-option:hover:not(:disabled),
    .weekly-poll .poll-option:focus-visible {
        background: var(--palette-dark);
        color: var(--palette-white);
    }

    .weekly-poll .poll-option:disabled {
        opacity: 0.6;
        cursor: wait;
    }

    .weekly-poll .poll-results {
        display: flex;
        flex-direction: column;
        gap: 0.6em;
    }

    .weekly-poll .poll-row-label {
        display: flex;
        gap: 0.4em;
    }

    .weekly-poll .poll-place {
        flex: none;
        width: 1.6em;
        font-weight: bold;
        color: var(--smb-text-color);
    }

    .weekly-poll .poll-text {
        flex: auto;
    }

    .weekly-poll .poll-pct {
        flex: none;
        font-weight: bold;
    }

    .weekly-poll .poll-row.mine .poll-text {
        font-weight: bold;
    }

    .weekly-poll .poll-bar {
        margin-left: 2em;
        height: 0.7em;
        border-radius: 999px;
        background: var(--palette-white);
        overflow: hidden;
    }

    .weekly-poll .poll-fill {
        height: 100%;
        border-radius: 999px;
        background: var(--palette-light);
        transition: width 0.6s ease-out;
    }

    .weekly-poll .poll-row.mine .poll-fill {
        background: var(--palette-dark);
    }

    .weekly-poll .poll-total,
    .weekly-poll .poll-note {
        margin-top: 0.75em;
        text-align: center;
        font-size: 0.9em;
    }

    .weekly-poll .poll-note:empty {
        display: none;
    }

    .weekly-poll .poll-fact {
        margin-top: 0.75em;
        padding-top: 0.6em;
        border-top: 1px dashed var(--palette-light);
        font-style: italic;
        text-align: center;
    }

    .weekly-poll .poll-last-week {
        margin-top: 0.6em;
        text-align: center;
        font-size: 0.9em;
    }
</style>
