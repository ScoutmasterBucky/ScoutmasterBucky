---
import ScaledContent from './scaled-content.astro';

// A news item is plain text (shown with a colored bullet), or an object to
// mark it NEW! and/or end it with a link ("Click here")
type NewsItem = string | { text: string; href?: string; linkText?: string; isNew?: boolean };

interface Props {
    news: NewsItem[];
}

const { news } = Astro.props.fontmatter || Astro.props;
const newsArray = (Array.isArray(news) ? news : []).map(item =>
    typeof item === 'string' ? { text: item } : item
);
---

<div class="news-wrapper">
    <div class="bucky-image">
        <ScaledContent align="center" small={true}>
            <img src="/images/bucky-with-newspaper.png" class="wide" />
        </ScaledContent>
    </div>

    <div class="news-list">
        {
            newsArray.map(item => (
                <div class="news-item">
                    {item.isNew ? (
                        <div class="news-new">NEW!</div>
                    ) : (
                        <div class="news-bullet" aria-hidden="true">&#9679;</div>
                    )}
                    <div>
                        {item.text}
                        {item.href && (
                            <>
                                {' '}<a href={item.href}>{item.linkText ?? 'Click here'}</a>
                            </>
                        )}
                    </div>
                </div>
            ))
        }
    </div>
</div>

<style>
    .news-wrapper {
        padding: 1em;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* Room between items so the list does not read as one block */
    .news-list {
        display: flex;
        flex-direction: column;
        gap: 0.8em;
        max-width: 46em;
        line-height: 1.45;
    }

    .news-item {
        display: flex;
        align-items: baseline;
        gap: 0.6em;
    }

    /* The NEW! tag and the bullets share a column so the text lines up */
    .news-new,
    .news-bullet {
        flex: none;
        width: 3.4em;
        text-align: center;
    }

    .news-new {
        padding: 0.05em 0;
        border-radius: 999px;
        background: var(--index-news-text-color);
        color: var(--palette-white);
        font-size: 0.8em;
        font-weight: bold;
    }

    .news-bullet {
        color: var(--index-news-text-color);
        font-size: 0.9em;
    }

    .news-item a {
        font-weight: bold;
        white-space: nowrap;
    }

    @media (min-width: 480.0001px) {
        .news-wrapper {
            flex-direction: row;
            gap: 2em;
        }
    }
</style>
