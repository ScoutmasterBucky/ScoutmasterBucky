        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1em;
    }

    .mbh-lightbox .pager[hidden] {
        display: none;
    }

    /* Kept above the printings panel, which otherwise covers it */
    .mbh-lightbox .close {
        position: absolute;
        z-index: 5;
        top: 0.4em;
        right: 0.5em;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 1.6em;
        height: 1.6em;
        padding: 0;
        border: 2px solid var(--palette-dark);
        border-radius: 50%;
        background: var(--palette-very-light);
        color: var(--palette-very-dark);
        font-size: 1.4em;
        line-height: 1;
        cursor: pointer;
    }

    .mbh-lightbox .close:hover {
        background: var(--palette-dark);
        color: #fff;
    }

    .mbh-growing {
        margin-top: 2em;
        padding: 0.8em 1em;
        border-left: 4px solid var(--palette-light);
        background: var(--palette-very-light);
    }

    /* The grand total looks like plain text; only those in the know click it */
    .egg {
        padding: 0;
        border: 0;
        background: none;
        color: inherit;
        font: inherit;
        cursor: text;
    }

    .mbh-data {
        max-width: min(95vw, 1100px);
        width: 100%;
        text-align: left;
    }

    .mbh-data h3 {
        margin: 0 2em 0.5em 0;
    }

    .mbh-data h4 {
        margin: 1em 0 0.3em;
    }

    .data-scroll {
        max-height: 34vh;
        overflow: auto;
        border: 1px solid #dfe3e6;
    }

    .mbh-data table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.75em;
    }

    /* Above the colored rows, which the site makes position: relative */
    .mbh-data th {
        position: sticky;
        top: 0;
        z-index: 2;
        background: var(--palette-very-light);
    }

    .mbh-data th,
    .mbh-data td {
        padding: 0.2em 0.4em;
        border-bottom: 1px solid #eef0f2;
        white-space: nowrap;
    }

    /* Bucky's workbook colors: green for printings he has, gray for years not made */
    .mbh-data tr.row-have td {
        background: #ccffcc;
    }

    .mbh-data tr.row-not-made td {
        background: #bfbfbf;
        color: #3d454c;
    }

    .mbh-data td.have {
        text-align: center;
        font-weight: bold;
    }

    .mbh-data td.notes {
        min-width: 16em;
        white-space: normal;
    }
</style>

<script>
    interface Photo {
        src: string;
        caption: string;
        alt?: string;
    }

    // Easter egg: the grand total opens the raw workbook data
    const dataDialog = document.querySelector<HTMLDialogElement>('.mbh-data');
    document.querySelector('.mbh .egg')?.addEventListener('click', () => dataDialog?.showModal());
    dataDialog?.querySelector('.close')?.addEventListener('click', event => {
        event.preventDefault();
        dataDialog.close();
    });
    dataDialog?.addEventListener('click', event => {
        if (event.target === dataDialog) {
            dataDialog.close();
        }
    });

    // Enlarged photo view, with arrows when a card has several photos
    const dialog = document.querySelector<HTMLDialogElement>('.mbh-lightbox:not(.mbh-data)');
    const img = dialog?.querySelector('img');
    const caption = dialog?.querySelector('.caption');
    const pager = dialog?.querySelector<HTMLElement>('.pager');
    const position = dialog?.querySelector('.position');
    let photos: Photo[] = [];
    let index = 0;

    function show(newIndex: number) {
        if (!img || !caption || !pager || !position) {
            return;
        }

        index = (newIndex + photos.length) % photos.length;
        img.src = photos[index].src;
        img.alt = photos[index].alt ?? photos[index].caption;
        caption.textContent = photos[index].caption;
        position.textContent = `${index + 1} of ${photos.length}`;
        pager.hidden = photos.length < 2;
    }

    // A cover's backs and printings, copied from its <template> into the side panel
    const panel = dialog?.querySelector<HTMLElement>('.lb-printings');

    function showPrintings(id?: string) {
        if (!panel || !dialog) {
            return;
        }

        const template = id ? document.getElementById(id) : null;
        panel.replaceChildren();
        if (template instanceof HTMLTemplateElement) {
            panel.append(template.content.cloneNode(true));
            panel.scrollTop = 0;
        }
        panel.hidden = !panel.childElementCount;
        dialog.classList.toggle('with-printings', !panel.hidden);

        // A back cover thumbnail shows that back in the main photo
        for (const back of panel.querySelectorAll<HTMLButtonElement>('.back-photo[data-src]')) {
            back.addEventListener('click', () => {
                const at = photos.findIndex(p => p.src === back.dataset.src);
                if (at >= 0) {
                    show(at);
                }
            });
        }
    }

    for (const button of document.querySelectorAll<HTMLButtonElement>(
        '.mbh .zoom'
    )) {
        button.addEventListener('click', () => {
            photos = JSON.parse(button.dataset.photos ?? '[]');
            if (dialog) {
                dialog.dataset.shape = button.dataset.shape ?? '';
            }
            showPrintings(button.dataset.printingsId);
            show(0);
            dialog?.showModal();
        });
    }

    dialog?.querySelector('.prev')?.addEventListener('click', () => show(index - 1));
    dialog?.querySelector('.next')?.addEventListener('click', () => show(index + 1));

    dialog?.addEventListener('keydown', event => {
        if (event.key === 'ArrowLeft') {
            show(index - 1);
        } else if (event.key === 'ArrowRight') {
            show(index + 1);
        }
    });

    // Close on the X directly, not only through its form, so nothing else can swallow the click
    dialog?.querySelector('.close')?.addEventListener('click', event => {
        event.preventDefault();
        dialog.close();
    });

    dialog?.addEventListener('click', event => {
        if (event.target === dialog) {
            dialog.close();
        }
    });

    // Timeline: pick a year, or step with the arrows
    for (const timeline of document.querySelectorAll<HTMLElement>('[data-timeline]')) {
        const stops = [...timeline.querySelectorAll<HTMLButtonElement>('.stop')];
        const events = [...timeline.querySelectorAll<HTMLElement>('.event')];
        let current = 0;

        const select = (i: number) => {
            current = (i + stops.length) % stops.length;
            stops.forEach((s, n) => s.setAttribute('aria-selected', String(n === current)));
            events.forEach((e, n) => (e.hidden = n !== current));
            stops[current].scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
        };

        stops.forEach((s, n) => s.addEventListener('click', () => select(n)));
        timeline.querySelector('.prev')?.addEventListener('click', () => select(current - 1));
        timeline.querySelector('.next')?.addEventListener('click', () => select(current + 1));
    }

    // Trivia: one question at a time, moving on every 10 seconds. Tapping a card
    // shows its answer and restarts the clock; hovering or focusing pauses it.
    for (const box of document.querySelectorAll<HTMLElement>('[data-trivia]')) {
        const cards = [...box.querySelectorAll<HTMLButtonElement>('.flip')];
        const dots = [...box.querySelectorAll<HTMLButtonElement>('.trivia-dots button')];
        let current = 0;
        let paused = false;
        let timer: number | undefined;

        const show = (i: number) => {
            current = (i + cards.length) % cards.length;
            cards.forEach((card, n) => {
                card.hidden = n !== current;
                card.setAttribute('aria-pressed', 'false');
            });
            dots.forEach((dot, n) => dot.setAttribute('aria-current', String(n === current)));
        };

        const restart = () => {
            window.clearInterval(timer);
            if (cards.length > 1) {
                timer = window.setInterval(() => {
                    if (!paused) {
                        show(current + 1);
                    }
                }, 10000);
            }
        };

        cards.forEach(card =>
            card.addEventListener('click', () => {
                card.setAttribute('aria-pressed', String(card.getAttribute('aria-pressed') !== 'true'));
                restart();
            })
        );
        dots.forEach((dot, n) =>
            dot.addEventListener('click', () => {
                show(n);
                restart();
            })
        );
        box.addEventListener('mouseenter', () => (paused = true));
        box.addEventListener('mouseleave', () => (paused = false));
        box.addEventListener('focusin', () => (paused = true));
        box.addEventListener('focusout', () => (paused = false));

        restart();
    }
</script>
