---
import HistoryCard from './merit-badge-history-card.astro';
import patchTypes from '~/data/merit-badge-history/patch-types.yaml';
import hardcoverTypes from '~/data/merit-badge-history/hardcover-types.yaml';
import {
    allBadgeHistories,
    coverMatcher,
    formatYears,
    historyLinks,
    historySections,
    sharedPhoto,
    span,
    titleSlug,
    visibleSections,
    typeSlug,
    type HistoryItem as Item,
    type Printing,
} from '~/utils/merit-badge-history';

interface Props {
    badge: string;
    history: {
        name: string;
        precededBy: string;
        precededByLink?: string;
        introduced: number | string;
        discontinued: string;
        replacedWith: string;
        story?: string[];
        thenAndNow?: {
            year: number;
            badge?: string;
            note?: string;
            source: string;
            requirements: string[];
        };
        timeline?: { year: number; text: string }[];
        trivia?: { q: string; a: string }[];
        // [rank, number of badges earned that year]
        ranks?: Record<string, [number, number]>;
        lifetimeRank?: { rank: number; asOf: number };
        // Estimated all-time place as of 2025, from each year's official ranking
        // and total (history-tools/estimate_alltime.py); range = likely places,
        // kept for reference but not shown
        lifetimeRankEstimate?: { rank: number; range?: [number, number]; asOf: number };
        earned?: {
            totalThrough: number;
            total: number;
            // The total adds up only the known years (counts shared with another badge)
            totalKnownOnly?: boolean;
            byYear: Record<string, number | null>;
        };
        patches: Item[];
        pamphlets: Item[];
        extraPrintings?: Printing[];
        hardcovers?: Item[];
        sources?: { title: string; url?: string }[];
    };
    printings?: Printing[];
    // Years the workbook marks "not made", for the easter egg table
    notMadeYears?: number[];
    // Draft pages link to every draft; public pages only to approved badges
    draft?: boolean;
}

const { badge, draft = false } = Astro.props;
const links = historyLinks(draft);

// A cover printed over an older type ("3A over 2") comes first among its type's
// covers (Bucky); otherwise the data file's order stands
function overCoversFirst(items: Item[]) {
    const family = (t: string) => parseInt(t) || 999;
    const isOver = (t: string) => (/ over /i.test(t) ? 0 : 1);
    return [...items].sort((a, b) => family(a.type) - family(b.type) || isOver(a.type) - isOver(b.type));
}

// Earned counts and rankings always show; every other section shows on the
// public page only once Bucky approves it (approved.yaml)
const show = visibleSections(badge, draft);
const data = Astro.props.history;
const history = {
    ...data,
    story: show.has('story') ? data.story : undefined,
    thenAndNow: show.has('requirements') ? data.thenAndNow : undefined,
    timeline: show.has('timeline') ? data.timeline : undefined,
    // One or the other (Bucky): the earliest requirements when there are any,
    // trivia only for badges without them
    trivia: show.has('trivia') && !(show.has('requirements') && data.thenAndNow) ? data.trivia : undefined,
    patches: show.has('patches') ? data.patches : [],
    pamphlets: show.has('pamphlets') ? overCoversFirst(data.pamphlets) : [],
    extraPrintings: show.has('pamphlets') ? data.extraPrintings : undefined,
    hardcovers: show.has('hardcovers') ? data.hardcovers : undefined,
};
const pending = historySections.filter(s => !show.has(s));

// "Preceded by" and "Replaced with" can name several badges ("Aerodynamics
// Aeronautics Airplane Design Airplane Structure"): link each badge name that
// has a history page, and separate them with commas
const badgeNames = allBadgeHistories()
    .map(b => ({ name: b.history.name, slug: b.slug }))
    .filter(b => b.slug !== badge)
    .sort((a, b) => b.name.length - a.name.length);

function lineageParts(text?: string) {
    const parts: { text: string; href?: string }[] = [];
    let rest = String(text ?? '');
    while (rest) {
        let found: { at: number; name: string; slug: string } | undefined;
        for (const b of badgeNames) {
            // Whole names only, so "Art" never matches inside "Arts"
            const name = b.name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            const at = rest.search(new RegExp(`(?<![A-Za-z])${name}(?![A-Za-z])`));
            if (at >= 0 && (!found || at < found.at)) {
                found = { at, ...b };
            }
        }
        if (!found) {
            parts.push({ text: rest });
            break;
        }
        const between = rest.slice(0, found.at);
        if (between) {
            parts.push({ text: parts.length && !between.trim() ? ', ' : between });
        }
        parts.push({ text: found.name, href: links.badge(found.slug) });
        rest = rest.slice(found.at + found.name.length);
    }
    return parts;
}
const precededParts = lineageParts(history.precededBy);
const replacedParts = lineageParts(history.replacedWith);
// Three or more badges don't fit a single fact box, so it takes two columns
const isLong = (parts: { href?: string }[]) => parts.filter(p => p.href).length > 2;
// Every printing from the workbook; the easter egg always shows these (Bucky's
// choice), while the Pamphlets section waits for approval
const workbookPrintings = [...(Astro.props.printings ?? []), ...(data.extraPrintings ?? [])];
const printings = show.has('pamphlets') ? workbookPrintings : [];
// The easter egg's rows, in year order like the workbook: printings plus the
// "not made" years (shown gray, as the workbook does)
const eggRows = [
    ...workbookPrintings.map(p => ({ printing: p as Printing | undefined, year: p.year })),
    ...(Astro.props.notMadeYears ?? []).map(year => ({ printing: undefined, year })),
].sort((a, b) => a.year - b.year);
const active = history.discontinued.toLowerCase() === 'current';
const fmt = (n: number) => n.toLocaleString('en-US');

// Earned by year
const years = Object.entries(history.earned?.byYear ?? {}).map(
    ([year, count]) => ({ year: Number(year), count, rank: history.ranks?.[year] })
);
const maxCount = Math.max(...years.map(y => y.count ?? 0), 1);
const decades = [...new Set(years.map(y => Math.floor(y.year / 10) * 10))];
const known = years.filter(y => y.count !== null && y.count > 0);
const peak = known.reduce((a, b) => ((b.count ?? 0) > (a.count ?? 0) ? b : a), known[0]);
const firstEarned = known[0];

// The estimated all-time place: one best-estimate number per badge, so every
// badge has its own place (Bucky's choice over showing too-close-to-call ranges)
const estimate = history.lifetimeRankEstimate;
const estimateText = estimate && `#${estimate.rank}`;

// Explain only what this badge's chart and table actually show
const hasUnknown = years.some(y => y.count === null);
const rankExample = [...years].reverse().find(y => y.rank)?.rank;
const notes = [
    hasUnknown && '"—" means merit badges were earned that year but the exact number is not currently known.',
    rankExample &&
        `"#${rankExample[0]} of ${rankExample[1]}" means the badge was number ${rankExample[0]} of the ${rankExample[1]} merit badges earned that year.`,
    years.some(y => y.year > 2020) && 'National counts have not been published since 2020, but the rankings have.',
    history.earned?.totalKnownOnly
        ? 'The total adds up only the years with a known count.'
        : hasUnknown && 'The grand total comes from official reports and includes the years without a known count.',
    estimate &&
        `The ${estimate.asOf} all-time place is an estimate, because the counts for 2021 to ${estimate.asOf} are worked out from each year's official ranking and the total number of merit badges earned that year.`,
].filter(Boolean) as string[];

const cardTypes = history.pamphlets.map(p => p.type.toUpperCase());
const cardFor = coverMatcher(history.pamphlets);

const backImage = (back?: string) => {
    // The photo files are all lowercase; the workbook writes some backs as "back-5A"
    return back && sharedPhoto(`/history/0-back-covers/${back.toLowerCase()}.webp`);
};

// "back-6b-2" -> "6B-2", "back-2-boy-scout-diary-25c" -> "2 Boy Scout Diary 25c"
function backName(back: string) {
    const name = back.replace(/^back-/, '');
    if (/^\d+[a-z]?(-\d+)?$|^\d{4}[a-z]\d$/.test(name)) {
        return name.toUpperCase();
    }

    return name
        .split('-')
        .map(word => word.charAt(0).toUpperCase() + word.slice(1))
        .join(' ');
}

interface BackGroup {
    back?: string;
    label: string;
    src?: string;
    years: string;
    printings: Printing[];
}

// Each cover's printings, grouped by the back cover they were printed with
const pamphletInfo = new Map<
    string,
    {
        years?: string;
        stats: string;
        backPhotos: { src: string; caption: string }[];
        backGroups: BackGroup[];
        have: number;
        count: number;
    }
>();
for (const type of cardTypes) {
    const mine = printings.filter(p => cardFor(p.cover) === type);
    if (!mine.length) {
        continue;
    }

    const have = mine.filter(p => p.status === 'have').length;
    const backGroups: BackGroup[] = [...new Set(mine.map(p => p.back))].map(back => {
        const used = mine.filter(p => p.back === back);
        return {
            back,
            label: back ? backName(back) : 'not recorded',
            src: backImage(back),
            years: span(used.map(p => p.year)),
            printings: used,
        };
    });

    pamphletInfo.set(type, {
        years: span(mine.map(p => p.year)),
        stats: `${mine.length} printing${mine.length === 1 ? '' : 's'} · ${have} in collection`,
        // Caption: "back" (always lowercase) and the back number, then the years
        // it was used; other details stay in the side panel
        backPhotos: backGroups
            .filter(g => g.src)
            .map(g => ({
                src: g.src as string,
                caption: `back ${g.label}\n${g.years}`,
                alt: `${history.name} merit badge pamphlet Type ${type}, back cover ${g.label}, ${g.years}`,
            })),
        backGroups,
        have,
        count: mine.length,
    });
}
const coverRows = history.pamphlets
    .map(item => ({ item, info: pamphletInfo.get(item.type.toUpperCase()) }))
    .filter(row => row.info);

// listed = not in the collection and not yet confirmed to exist
const statusLabel = { have: 'In collection', confirmed: 'Confirmed, not in collection', listed: 'Unconfirmed' };
const printingCounts = {
    all: printings.length,
    have: printings.filter(p => p.status === 'have').length,
    confirmed: printings.filter(p => p.status === 'confirmed').length,
    listed: printings.filter(p => p.status === 'listed').length,
};
---

<div class="mbh">
    <section class="mbh-facts" aria-label="Quick facts">
        {show.has('facts') && (
            <>
                <div class="fact">
                    <span class="label">Introduced</span>
                    <span class="value">{history.introduced}</span>
                </div>
                <div class:list={['fact', { long: isLong(precededParts) }]}>
                    <span class="label">Preceded by</span>
                    <span class="value">
                        {precededParts.map(p => (p.href ? <a href={p.href}>{p.text}</a> : p.text))}
                    </span>
                </div>
                <div class="fact">
                    <span class="label">Status</span>
                    <span class="value">
                        {active ? 'Active' : `Discontinued ${history.discontinued}`}
                    </span>
                </div>
            </>
        )}
        {
            show.has('facts') && !active && (
                <div class:list={['fact', { long: isLong(replacedParts) }]}>
                    <span class="label">Replaced with</span>
                    <span class="value">
                        {replacedParts.map(p => (p.href ? <a href={p.href}>{p.text}</a> : p.text))}
                    </span>
                </div>
            )
        }
        {
            history.earned && (
                <div class="fact highlight">
                    <span class="label">
                        Earned through {history.earned.totalThrough}
                    </span>
                    <span class="value">{fmt(history.earned.total)}</span>
                </div>
            )
        }
        {
            peak && (
                <div class="fact">
                    <span class="label">Best year</span>
                    <span class="value">{peak.year}</span>
                    <span class="sub">{fmt(peak.count ?? 0)} earned</span>
                </div>
            )
        }
        {
            history.lifetimeRank && (
                <div class="fact">
                    <span class="label">All-time popularity</span>
                    <span class="value">#{history.lifetimeRank.rank}</span>
                    <span class="sub">official, as of {history.lifetimeRank.asOf}</span>
                    {estimate && (
                        <span class="estimate" title="Estimated from each year's official ranking and total number of merit badges earned">
                            <span class="estimate-rank">{estimateText}</span>
                            <span class="estimate-label">by {estimate.asOf} (estimate)</span>
                        </span>
                    )}
                </div>
            )
        }
    </section>

    {
        history.story && (
            <>
                <h2 id="story">The Story</h2>
                <div class="mbh-story">
                    {history.story.map(p => <p>{p}</p>)}
                </div>
            </>
        )
    }

    {
        // Requirements and trivia side by side; either can stand alone
        (history.thenAndNow || (history.trivia && history.trivia.length > 0)) && (
            <section
                class:list={['mbh-then-now', { single: !history.thenAndNow || !history.trivia?.length }]}
                aria-label="Then and now"
            >
                {history.thenAndNow && (
                    <div class="then">
                        <h3>
                            {history.thenAndNow.year}
                            {history.thenAndNow.badge && ` ${history.thenAndNow.badge}`} requirements
                        </h3>
                        {history.thenAndNow.note && <p class="small">{history.thenAndNow.note}</p>}
                        <ol>
                            {history.thenAndNow.requirements.map(r => <li>{r}</li>)}
                        </ol>
                        <p class="small">Source: {history.thenAndNow.source}</p>
                    </div>
                )}
                {history.trivia && history.trivia.length > 0 && (
                    // One question at a time, changing every 10 seconds
                    <div class="now" data-trivia>
                        <h3>Trivia</h3>
                        <div class="trivia-cards" aria-live="polite">
                            {history.trivia.map((t, i) => (
                                <button
                                    type="button"
                                    class="flip"
                                    aria-pressed="false"
                                    data-index={i}
                                    hidden={i !== 0}
                                >
                                    <span class="q">{t.q}</span>
                                    <span class="a">{t.a}</span>
                                </button>
                            ))}
                        </div>
                        <div class="trivia-dots" role="group" aria-label="Trivia questions">
                            {history.trivia.map((_, i) => (
                                <button
                                    type="button"
                                    aria-label={`Question ${i + 1}`}
                                    aria-current={i === 0 ? 'true' : 'false'}
                                    data-index={i}
                                />
                            ))}
                        </div>
                    </div>
                )}
            </section>
        )
    }

    {
        history.timeline && (
            <>
                <h2>Timeline</h2>
                <div class="mbh-timeline" data-timeline>
                    <div class="track" role="tablist" aria-label="Timeline years">
                        {history.timeline.map((event, i) => (
                            <button
                                type="button"
                                role="tab"
                                class="stop"
                                aria-selected={i === 0 ? 'true' : 'false'}
                                data-index={i}
                            >
                                <span class="dot" />
                                <span class="yr">{event.year}</span>
                            </button>
                        ))}
                    </div>
                    <div class="panel" aria-live="polite">
                        <button type="button" class="nav prev" aria-label="Previous event">&lsaquo;</button>
                        <div class="panel-body">
                            {history.timeline.map((event, i) => (
                                <p class="event" data-index={i} hidden={i !== 0}>
                                    <strong>{event.year}</strong> {event.text}
                                </p>
                            ))}
                        </div>
                        <button type="button" class="nav next" aria-label="Next event">&rsaquo;</button>
                    </div>
                </div>
            </>
        )
    }

    {history.patches.length > 0 && (<>
    <h2 id="patches">Merit Badge Patches</h2>
    <p class="mbh-intro">
        Select a patch to enlarge it; many include the back.
    </p>
    <ol class="mbh-grid patches">
        {
            history.patches.map(item => (
                <HistoryCard
                    item={item}
                    what={`${history.name} merit badge`}
                    shape="round"
                    typeInfo={patchTypes[item.type] && `${patchTypes[item.type].name}: ${patchTypes[item.type].text}`}
                    titleHref={patchTypes[item.type] && links.patchType(item.type)}
                />
            ))
        }
    </ol>
    <details class="mbh-guide">
        <summary>What do the patch types mean?</summary>
        <dl>
            {Object.entries(patchTypes)
                // Only the types this badge's cards show
                .filter(([type]) => history.patches.some(p => p.type === type))
                .map(([type, info]) => (
                <>
                    <dt>Type {type}</dt>
                    <dd>
                        <strong>{info.name}</strong>
                        {info.years && <span class="guide-years"> ({formatYears(info.years)})</span>}.{' '}
                        {info.text}
                    </dd>
                </>
            ))}
        </dl>
        <p class="small">Dates are approximate and can vary by badge.</p>
    </details>
    </>)}

    {history.pamphlets.length > 0 && (<>
    <h2 id="pamphlets">Merit Badge Pamphlets</h2>
    <p class="mbh-source">The printings come from Scoutmaster Bucky's own collection and research.</p>
    <p class="mbh-intro">Select a cover to see its back covers and every known printing.</p>
    {
        printings.length > 0 && (
            <p class="mbh-printing-summary">
                {/* Only the groups that have printings; "all in the collection" when nothing is missing */}
                <span>
                    <strong>{printingCounts.all} printing{printingCounts.all === 1 ? '' : 's'}</strong>{
                        printingCounts.have === printingCounts.all
                            ? printingCounts.all === 1 ? ', in the collection.' : ', all in the collection.'
                            : ':'
                    }
                </span>
                {printingCounts.have > 0 && printingCounts.have < printingCounts.all && (
                    <span class="chip have">{printingCounts.have} in collection</span>
                )}
                {printingCounts.confirmed > 0 && (
                    <span class="chip confirmed">{printingCounts.confirmed} confirmed, not in collection</span>
                )}
                {printingCounts.listed > 0 && (
                    <span class="chip listed" title="Not in the collection and not yet confirmed to exist; some may turn out not to exist">
                        {printingCounts.listed} unconfirmed
                    </span>
                )}
            </p>
        )
    }
    <ol class="mbh-grid pamphlets">
        {
            history.pamphlets.map(item => {
                const info = pamphletInfo.get(item.type.toUpperCase());
                return (
                    <HistoryCard
                        item={item}
                        what={`${history.name} merit badge pamphlet`}
                        shape="cover"
                        years={info?.years}
                        extraPhotos={info?.backPhotos}
                        printingsId={info && `printings-${typeSlug(item.type)}`}
                        titleHref={links.pamphletType(item.type)}
                    />
                );
            })
        }
    </ol>

    {
        coverRows.length > 0 && (
            // One template per cover; the enlarged view copies it into its side panel
            <div class="mbh-printing-templates">
                {coverRows.map(({ item, info }) => (
                    <template id={`printings-${typeSlug(item.type)}`}>
                        <div class="panel-head">
                            <strong>Type {item.type}</strong> {info.years}
                            <span class="muted">
                                {info.backGroups.length} back{info.backGroups.length === 1 ? '' : 's'} ·{' '}
                                {info.count} printing{info.count === 1 ? '' : 's'} · {info.have} in collection
                            </span>
                        </div>
                        <div class="back-groups">
                            {info.backGroups.map(group => {
                                const numbers = [...new Set(group.printings.map(p => [p.bsaNumber, p.sku, p.saNumber].filter(Boolean).join(' / ')))].filter(Boolean);
                                return (
                                    <div class="back-group">
                                        {group.src ? (
                                            <button
                                                type="button"
                                                class="back-photo"
                                                title="Show this back cover"
                                                data-src={group.src}
                                            >
                                                <img src={group.src} alt={`Back cover ${group.label}`} />
                                            </button>
                                        ) : (
                                            <span class="back-photo none">No photo</span>
                                        )}
                                        <div class="back-detail">
                                            <div class="back-label">
                                                <strong>back {group.label}</strong>
                                                <span class="muted">
                                                    {group.years}
                                                    {numbers.length === 1 && ` · No. ${numbers[0]}`}
                                                </span>
                                            </div>
                                            <ul class="chips">
                                                {group.printings.map(p => {
                                                    // A note (e.g. "with pasted 1927 Requirements") marks a
                                                    // distinct printing, so it stays inside that printing's chip
                                                    const extra = [
                                                        numbers.length > 1 && `No. ${[p.bsaNumber, p.sku, p.saNumber].filter(Boolean).join(' / ')}`,
                                                        p.notes,
                                                        p.hardcover && `Hard cover ${p.hardcover}`,
                                                    ].filter(Boolean);
                                                    return (
                                                        <li
                                                            class:list={['chip', p.status, { detailed: extra.length > 0 }]}
                                                            title={statusLabel[p.status]}
                                                        >
                                                            <span class="when">
                                                                {[p.month ? `${p.year} ${p.month.slice(0, 3)}` : `${p.year}`, p.printRun].filter(Boolean).join(' · ')}
                                                            </span>
                                                            {extra.map(text => <span class="extra">{text}</span>)}
                                                        </li>
                                                    );
                                                })}
                                            </ul>
                                        </div>
                                    </div>
                                );
                            })}
                        </div>
                        <p class="legend">
                            <span class="chip have">In collection</span>
                            <span class="chip confirmed">Confirmed, not in collection</span>
                            <span class="chip listed">Unconfirmed: not yet seen, may not exist</span>
                            <span class="muted">M = thousand copies, as printed on the pamphlet.</span>
                        </p>
                    </template>
                ))}
            </div>
        )
    }
    </>)}

    {
        history.hardcovers && history.hardcovers.length > 0 && (
            <>
                <h3>Hard Cover Varieties</h3>
                <ol class="mbh-grid pamphlets">
                    {history.hardcovers.map(item => (
                        <HistoryCard
                            item={item}
                            what={`${history.name} hard cover`}
                            shape="cover"
                            titleHref={(hardcoverTypes[item.type.toUpperCase()] || /^HC(LM|LX|QQ)$|MISC/i.test(item.type)) && links.hardcoverType(item.type)}
                        />
                    ))}
                </ol>
            </>
        )
    }

    {
        history.earned && (
            <>
                <h2 id="earned">Earned by Year</h2>
                {firstEarned && (
                    <p class="mbh-intro">
                        First earned in {firstEarned.year}. Peak year {peak.year} with {fmt(peak.count ?? 0)}.
                        Hover over or tap a year for its numbers.
                    </p>
                )}
                <div class="mbh-chart-wrap">
                    <div
                        class="mbh-chart"
                        role="group"
                        aria-label={`Bar chart of ${history.name} merit badges earned each year, ${years[0].year} to ${years[years.length - 1].year}. Full numbers are in the table below.`}
                    >
                        {years.map((y, i) => (
                            <div
                                class:list={[
                                    'bar',
                                    { unknown: y.count === null },
                                    // Keep the tips at either end inside the chart
                                    { start: i < 4, end: i >= years.length - 4 },
                                ]}
                                style={`--h: ${y.count === null ? 0 : (y.count / maxCount) * 100}%`}
                                tabindex="0"
                            >
                                <span class="tip">
                                    <strong>{y.year}</strong>
                                    {y.count === null ? (
                                        <span>No data available</span>
                                    ) : (
                                        <span>{fmt(y.count)} earned</span>
                                    )}
                                    {y.rank && (
                                        <span>#{y.rank[0]} of {y.rank[1]}</span>
                                    )}
                                </span>
                            </div>
                        ))}
                    </div>
                    <div class="mbh-axis" aria-hidden="true">
                        {decades.map(d => {
                            const span = years.filter(
                                y => Math.floor(y.year / 10) * 10 === d
                            ).length;

                            // Too narrow to fit a label for a partial decade
                            return (
                                <span style={`--span: ${span}`}>
                                    {span >= 4 && d}
                                </span>
                            );
                        })}
                    </div>
                </div>
                {hasUnknown && (
                    <p class="mbh-legend">
                        <span class="swatch known" /> Known count
                        <span class="swatch unknown" /> No data available
                    </p>
                )}
                {notes.length > 0 && <p class="footnote">{notes.join(' ')}</p>}

                <div class="mbh-years">
                    {
                        // Pad the first decade so every row starts on a 0 year
                        Array.from({ length: years[0].year % 10 }, () => (
                            <div class="cell pad" aria-hidden="true" />
                        ))
                    }
                    {years.map(y => (
                        <div class:list={['cell', { unknown: y.count === null }]}>
                            <span class="yr">{y.year}</span>
                            <span class="num">
                                {y.count === null ? '—' : fmt(y.count)}
                            </span>
                            {y.rank ? (
                                <span class="rank">#{y.rank[0]} of {y.rank[1]}</span>
                            ) : (
                                y.count === 0 && <span class="rank">none earned</span>
                            )}
                        </div>
                    ))}
                    {Array.from(
                        { length: 9 - (years[years.length - 1].year % 10) },
                        () => <div class="cell pad" aria-hidden="true" />
                    )}
                </div>
                <p class="mbh-total">
                    {history.earned.totalKnownOnly ? 'Total of the known years' : 'Grand total'} through {history.earned.totalThrough}:
                    {/* Easter egg: the number opens the raw workbook data */}
                    <button type="button" class="egg"><strong>{fmt(history.earned.total)}</strong></button>
                </p>
            </>
        )
    }

    {
        !draft && pending.length > 0 && (
            <p class="mbh-growing">
                {`This page keeps growing. More of this badge's history${
                    pending.includes('patches') && pending.includes('pamphlets') ? ', including its patches and pamphlets,' : ''
                } is being checked and will be added once it is confirmed.`}
            </p>
        )
    }

    <dialog class="mbh-lightbox mbh-data">
        <form method="dialog">
            <button class="close" aria-label="Close">&times;</button>
        </form>
        <h3>{history.name}: workbook data</h3>
        <h4>Printings ({workbookPrintings.length})</h4>
        <div class="data-scroll">
            <table>
                <thead>
                    <tr>
                        <th>Have</th><th>Year</th><th>Month</th><th>Cover</th><th>Back</th><th>Run</th><th>©</th>
                        <th>BSA #</th><th>UPC</th><th>SKU</th><th>SA #</th><th>HC</th><th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    {eggRows.map(({ printing: p, year }) =>
                        p ? (
                            // The workbook's own marks: x = have (green), c = confirmed, blank = neither
                            <tr class:list={{ 'row-have': p.status === 'have' }}>
                                <td class="have">{{ have: 'x', confirmed: 'c' }[p.status] ?? ''}</td>
                                <td>{p.year}</td><td>{p.month}</td><td>{p.cover}</td><td>{p.back}</td>
                                <td>{p.printRun}</td><td>{p.copyright}</td><td>{p.bsaNumber}</td><td>{p.upc}</td>
                                <td>{p.sku}</td><td>{p.saNumber}</td><td>{p.hardcover}</td>
                                <td class="notes">{p.notes}</td>
                            </tr>
                        ) : (
                            <tr class="row-not-made">
                                <td class="have" />
                                <td>{year}</td>
                                <td colspan="11">not made</td>
                            </tr>
                        )
                    )}
                </tbody>
            </table>
        </div>
        <h4>Earned and rank by year</h4>
        <div class="data-scroll">
            <table>
                <thead>
                    <tr><th>Year</th><th>Earned</th><th>Rank</th><th>Of</th></tr>
                </thead>
                <tbody>
                    {years.map(y => (
                        <tr>
                            <td>{y.year}</td>
                            <td>{y.count === null ? '' : fmt(y.count)}</td>
                            <td>{y.rank?.[0]}</td>
                            <td>{y.rank?.[1]}</td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
    </dialog>

    <dialog class="mbh-lightbox">
        <form method="dialog">
            <button class="close" aria-label="Close">&times;</button>
        </form>
        <div class="lb-body">
            <div class="lb-photo">
                <img alt="" />
                <p class="caption"></p>
                <div class="pager" hidden>
                    <button class="prev" type="button" aria-label="Previous photo">
                        &lsaquo;
                    </button>
                    <span class="position"></span>
                    <button class="next" type="button" aria-label="Next photo">
                        &rsaquo;
                    </button>
                </div>
            </div>
            <div class="lb-printings" hidden></div>
        </div>
    </dialog>
</div>

<style>
    .mbh {
